PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-waste
JWT_SECRET=change_this_to_a_long_random_string
# Frontend origin(s), comma separated. Leave empty to allow any origin in development.
CLIENT_URL=http://localhost:5173

# Photo uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# BIN_MATCH_RADIUS_M=40     reports within this many metres share one bin
# GEOCODE_COUNTRY=in        limit place search to a country code
